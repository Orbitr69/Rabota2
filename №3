#include <unistd.h>
#include <fcntl.h>

int main() {
    int i = open("in.txt", O_RDONLY);
    int o = open("out.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
    
    char s[3][100];
    int n = 0, p = 0;
    char c;
    
    while (n < 3 && read(i, &c, 1) > 0) {
        s[n][p++] = c;
        if (c == '.' || c == '!' || c == '?') {
            s[n][p] = '\0';
            n++;
            p = 0;
        }
    }
    
    for (int j = n-1; j >= 0; j--) {
        int k = 0;
        while (s[j][k]) write(o, &s[j][k++], 1);
        write(o, "\n", 1);
    }
    
    close(i);
    close(o);
    
    int r = open("out.txt", O_RDONLY);
    char b[100];
    int x;
    while ((x = read(r, b, 100)) > 0) write(1, b, x);
    close(r);
    
    return 0;
}
