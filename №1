#include <stdio.h>

int HasZero(int* a, int n) {
	for (int i = 0; i < n; i++) {
		if (a[i] == 0) return 1;
	}
	return 0;
}

void printLine(int* a, int n) {
	for (int i = 0; i < n; i++) printf("%4d ", a[i]);
}
int main() {
	const int n = 4;
	const int m = 5;

	int matr[n][m] = { 1, 2, 3, 4, 5, 0, 7, 8, 9, 10, 11, 12, 13, 14, 0, 16, 17, 18, 19, 20 };

	printf("\n");
	for (int i = 0; i < n; i++) {
		printLine(matr[i], m);
		printf("\n");
	}

	int countWithoutZero = 0;
	for (int i = 0; i < n; i++) {
		if (HasZero(matr[i], m) == 0)
			countWithoutZero++;
	}
	printf("\n Count row without zero: %d", countWithoutZero);
	return 0;
}
